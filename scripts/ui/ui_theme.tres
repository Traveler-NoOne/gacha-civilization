[sub_resource type="SystemFont" id="SystemFont_bold"]
font_names = PackedStringArray("Microsoft YaHei", "微软雅黑", "SimHei", "黑体", "Noto Sans SC", "Source Han Sans SC", "sans-serif")
font_weight = 700

[sub_resource type="SystemFont" id="SystemFont_regular"]
