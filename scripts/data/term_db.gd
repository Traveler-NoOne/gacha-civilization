class_name TermDB
extends RefCounted
## 专有名词与世界观设定的数据源（v1.1：由「图鉴」迁入新的「手册」子系统）。
##
## v1.1 更新指导：图鉴里的「名词」分类移动到手册子系统，
## 手册子系统专门作为对一些专有名词和世界观设定进行解释的设定集。

## 每条：{ group, name, text }
static func all() -> Array[Dictionary]:
	var out: Array[Dictionary] = []

	# ---------------- 等级体系 ----------------
	out.append(_t("等级体系", "大等级 Alpha ~ Epsilon",
		"Alpha / Beta / Gamma / Delta / Epsilon…：作为跨越非常大的大等级。Alpha 为低等级，Delta 为高等级。"))
	out.append(_t("等级体系", "小等级 G ~ A",
		"G / F / E / D / C / B / A：作为跨越较小的小等级。G 为低等级，A 为高等级。U 为论外，无法统计的等级。"))
	out.append(_t("等级体系", "稀有度",
		"1★ 普通 / 2★ 优良 / 3★ 稀有 / 4★ 史诗 / 5★ 传说。图鉴中的「稀有度」二级分类即按此筛选。"))

	# ---------------- 文明组 ----------------
	out.append(_t("文明组", "提瓦特",
		"文明组之一。v1.1 之前叫做「原神组」。成员包含岩构骑士、风羽游侠、草生术士、水镜使、炽炎枪兵、霜原猎手、雷纹先锋等。"))
	out.append(_t("文明组", "绝区零",
		"文明组之一。v1.1 之前叫做「绝区零组」。成员包含虚狩·空洞、代理人·刃、邦布·工蜂、以太体等。"))
	out.append(_t("文明组", "崩坏本征",
		"文明组之一。v1.1 之前叫做「崩坏组」。成员包含空律·崩坏、女武神·白夜、崩坏机兵、圣痕持有者、重装射手等。"))
	out.append(_t("文明组", "文明组与稀有度的关系",
		"文明组与稀有度是两个互相独立的二级分类，可以同时生效：先按文明组圈定范围，再按稀有度筛选星级。"))

	# ---------------- 世界名词 ----------------
	out.append(_t("世界名词", "据点 / 城邦 / 省市",
		"玩家派出人力建造后所占据的地块，伴随管理升级可强化并扩张地块。"))
	out.append(_t("世界名词", "量子之海",
		"存在于平行宇宙之间的特殊维度空间，由「以太」物质构成；经「涨落」成膜，膜可进一步演化为世界泡。它独立于四维时空之外，是容纳所有世界泡的「海洋」。"))
	out.append(_t("世界名词", "世界泡",
		"由量子之海中的膜演化而成的独立小世界——我们所在的这枚世界泡，正漂浮在量子之海中。附近的世界泡大多已濒临末日，因此被召唤来的存在往往愿意留下。"))
	out.append(_t("世界名词", "稳定度",
		"根据世界中玩家的占领地块数量和危险地区等因素计算的百分比。公式：((玩家总战斗力 / 敌人总战斗力) × (空白格子数 / (空白格子数 + 1))) × (1 − (敌人数量 / 地图总格子数) × 0.5)。稳定度低于 10% 时无法进行世界泡操作。"))
	out.append(_t("世界名词", "危险地块",
		"包括但不限于存在游荡敌人、高危据点的地块。"))
	out.append(_t("世界名词", "高危据点",
		"会不断在世界上生成游荡敌人的据点。打捞系统（资源池）时有较大概率生成，次数越多概率越高，生成后概率重置；生成 10 次高危据点后必定生成一次极度高危据点。"))
	out.append(_t("世界名词", "游荡敌人",
		"每次周期结束将随机或定向在地块上移动，移动到玩家地块时如果没有防卫力量，玩家地块将被直接攻击。召唤系统（轮换池）时大概率生成，90 次后必定生成一次高危游荡敌人。"))
	out.append(_t("世界名词", "损坏",
		"被攻击时进行（防御力 − 攻击力）的计算后再结算，每次破坏度结算时将随机对地块内的建筑进行损坏；当地块内的所有建筑被彻底破坏将失去并转换为无主地块。"))
	out.append(_t("世界名词", "终极威胁",
		"发展系统必定生成。生成后（威胁度相关数值）个周期内，如果有无主地块将在其上继续游荡，并且会消灭非同势力的高危据点或游荡敌人；计时结束后以玩家的首都为目标直线前进，消灭中途的一切威胁。"))
	out.append(_t("世界名词", "首都",
		"可被玩家迁移，一旦首都被彻底破坏，游戏将结束。"))
	out.append(_t("世界名词", "空间威胁",
		"由当前周期威胁度决定的数值。"))

	# ---------------- 建筑与运营 ----------------
	out.append(_t("建筑与运营", "幸福值",
		"根据建筑类型、制度等多个因素计算。基础 50，叠加建筑加成与民怨，取值 0~100。"))
	out.append(_t("建筑与运营", "文化率",
		"由教育及文化建筑提升，作为凝聚力结算的倍率。"))
	out.append(_t("建筑与运营", "人力",
		"由人口与住房上限决定。指派到建筑上才会产出；未指派的人力只消耗食物。"))
	out.append(_t("建筑与运营", "周期",
		"本 Demo 的回合单位。每个周期结束会结算建筑产出、维护、人口、世界演化与抽卡货币，并自动存档。"))

	# ---------------- 单位与战斗（v1.1） ----------------
	out.append(_t("单位与战斗", "职业",
		"决定克制关系，暂时分为近身战士、远身战士、投射者、防御者、支援者五种。"))
	out.append(_t("单位与战斗", "位阶",
		"决定战斗时部分属性的倍率，暂时分为募集军、正规军、角色三种。"))
	out.append(_t("单位与战斗", "募集军",
		"刚招募的军队单位，对战斗并不熟练，甚至常常犯错，因此倍率为负修正（0.6~0.8 倍率）。经验值上限 100 点。"))
	out.append(_t("单位与战斗", "正规军",
		"招募已久、训练已久或短时间经历过惨烈战斗的单位，有丰富的战斗经验，不会再犯低级错误（0.8~1.1 倍率）。经验值上限 200 点。"))
	out.append(_t("单位与战斗", "角色",
		"通常为通过特殊事件转换的单位，或抽卡获得，具备独特性；在世界的眷顾下不会产生负修正（1.0~2.0 倍率）。经验值上限 500 点。"))
	out.append(_t("单位与战斗", "经验值",
		"决定位阶倍率在同一区间内由低到高。可以通过周期循环缓缓增长，但每个单位最多通过这种方式获得 100 点经验；其余经验来自战斗。"))
	out.append(_t("单位与战斗", "近身战士",
		"利用格斗术或匕首刀剑的战士，通常在复杂环境下活动，具备灵活性。克制防御者和支援者。"))
	out.append(_t("单位与战斗", "远身战士",
		"使用长枪或大剑的战士，能够通过武器控制距离、阻止近身。克制近身战士和防御者。"))
	out.append(_t("单位与战斗", "投射者",
		"使用枪械或弓弩的战士，在机制上能够在间隔一个格子的情况下伤害到其他单位（射程 2 格）。克制近身战士和远身战士。"))
	out.append(_t("单位与战斗", "防御者",
		"以抵抗或帮助友军阻止敌人远程投送武力，能够小幅度减免所在格子的单位以及队伍中单位所受伤害，大幅度减免投射者造成的伤害。"))
	out.append(_t("单位与战斗", "支援者",
		"并不直接造成伤害，而是根据条件增幅特定单位的伤害或提供减免。"))
	out.append(_t("单位与战斗", "编队",
		"一个世界格子最多存在四个单位；一个队伍最多同时存在四个单位。"))
	out.append(_t("单位与战斗", "战斗结算",
		"除非有专门的设计，否则都是个体单位对个体单位造成伤害；当目标格子存在多个单位时需要专门选择。敌人 AI 面对存在多个玩家单位的格子时随机选择，只有高危及以上的敌人才会考虑克制关系。"))

	# ---------------- 世界泡与经济 ----------------
	out.append(_t("世界泡与经济", "秩序结晶",
		"根据玩家等级每周期结算给予，是「打捞系统」的货币。"))
	out.append(_t("世界泡与经济", "稳定度（货币）",
		"获取和花费方式较为复杂，与世界的占领情况相关。"))
	out.append(_t("世界泡与经济", "凝聚力",
		"根据民众的幸福程度与文化率结算：幸福程度给予数值，文化率给予倍率。是「召唤系统」的货币。"))
	out.append(_t("世界泡与经济", "卡池分组",
		"召唤系统在特定卡组之间轮换（提瓦特 / 崩坏本征 / 绝区零），可以每天轮换一次，也可以手动轮换。只能唤来角色和装备。"))
	out.append(_t("世界泡与经济", "高级材料",
		"同一卡组内角色的突破材料、周本材料等统称高级材料。某个组内角色的高级材料只有在「召唤」处于该组期间，才能在打捞系统内被捞出来。"))
	out.append(_t("世界泡与经济", "发展系统",
		"不消耗货币，但是必定在大世界生成终极威胁。可以抽到很多功能，例如让原本只能靠打捞获取的材料在世界发展中自然、可再生地获取。"))

	# ---------------- 科技 ----------------
	out.append(_t("科技", "经典科技树 · 开采",
		"前置：无。消耗 5 科研点。解锁建筑：经典矿场。"))
	out.append(_t("科技", "原神科技树 · 炼金-黑土",
		"前置：创世结晶（由发展系统获得）。消耗 120 科研点。解锁建筑：黑土学院、炼金所。"))

	return out


static func _t(group: String, name: String, text: String) -> Dictionary:
	return {"group": group, "name": name, "text": text}


## 手册里的分组顺序
static func groups() -> Array[String]:
	var out: Array[String] = []
	for t in all():
		var g := str(t["group"])
		if not out.has(g):
			out.append(g)
	return out