; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="抽卡文明"
config/description="抽卡文明 · 可玩 Demo（几何图形占位美术）"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AppSettings="*res://scripts/core/app_settings.gd"
GameState="*res://scripts/core/game_state.gd"
UI="*res://scripts/core/ui_scale.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"
; ⚠️ 1.8.20 备忘（都别踩）：窗口锁定（不许拖边）**不写在这里** ——
; 改由 main.gd 运行期设 DisplayServer.window_set_flag(WINDOW_FLAG_RESIZE_DISABLED)，写这儿会「改了没生效」。
;
; 1.8.21.2：上面这段原本是两行**被写坏的键**（备忘文字被当成键名，还把 [editor_plugins] 段头吞进了引号里）。
; 原文已双重编码且丢过字节、无法逐字还原，所以只保留它能表达的信息，并把段头建回来。
[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom="res://scripts/ui/ui_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
