; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="抽卡文明"
config/description="抽卡文明 · 可玩 Demo（几何图形占位美术）"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AppSettings="*res://scripts/core/app_settings.gd"
GameState="*res://scripts/core/game_state.gd"
UI="*res://scripts/core/ui_scale.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
# v1.8.20：删掉这两行 —— 它们会在启动时强制窗口尺寸，把「分辨率设置」顶回去
#（实测症状：UI 按新分辨率放大了，窗口却还是 1280）。窗口尺寸改由 main._apply_resolution() 决定。

# v1.8.20-B：关掉自动拉伸 —— UI 从此按真实像素排版，尺寸走 UI 词典（UI.px()/fs()）。
window/stretch/mode="disabled"

window/stretch/aspect="expand"
# ⚠️ 1.8.20 备忘（都别踩）：
#   · 窗口锁定（不许拖边）**不写在这里**，改由 main.gd 运行期设 —— 写 resizable=false
#     会把无头测试的窗口压到最小尺寸（实测视口高只剩 64），连累依赖视口尺寸的测试。
#   · 关掉 stretch 后，无头视口的尺寸就等于真实窗口（实测 64 高），所以

#     dialog_layer.fit_now() 对"视口小得离谱"做了兜底：vh < 200 时按设计基准高度算。


[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/custom="res://scripts/ui/ui_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
